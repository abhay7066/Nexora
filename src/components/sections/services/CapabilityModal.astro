---
import { ArrowRight, CheckCircle2, Cpu, Layers, Sparkles } from "@lucide/astro";
import Icon from "../../common/Icon.astro";
import { MODAL_EXECUTION_PHASES } from "../../../data/site.js";

interface Props {
  service: {
    slug: string;
    title: string;
    tagline: string;
    description: string;
    icon: string;
    bullets: string[];
    categoryKey: string;
    categoryName: string;
  };
}
const { service } = Astro.props;
---

<dialog id={`modal-${service.slug}`} class="capability-dialog glass-strong" data-capability-modal>
  <div class="relative p-6 sm:p-8">
    <button type="button" class="capability-dialog-close absolute right-4 top-4 grid size-8 place-items-center rounded-md text-muted-foreground transition-colors hover:text-foreground" aria-label="Close">
      ✕
    </button>

    <div class="flex items-center gap-3">
      <div class="grid size-10 sm:size-12 shrink-0 place-items-center rounded-xl bg-primary/10 text-primary border border-primary/20">
        <Icon name={service.icon} class="size-5 sm:size-6" />
      </div>
      <div>
        <span class="text-[11px] font-mono uppercase tracking-widest text-primary font-semibold">{service.categoryName}</span>
        <h3 class="text-xl sm:text-2xl font-display font-bold text-foreground">{service.title}</h3>
      </div>
    </div>
    <p class="text-sm font-medium text-primary/90 mt-3">{service.tagline}</p>

    <div class="mt-4 space-y-6 text-sm">
      <p class="text-muted-foreground leading-relaxed">
        {service.description} Our senior operators design and deploy this capability directly into your core business
        infrastructure, ensuring complete system alignment.
      </p>

      <div class="rounded-xl border border-border/60 bg-surface-card p-5">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-muted-foreground mb-3 font-semibold">
          <Layers class="size-4 text-primary" />
          <span>Core Included Scope & Deliverables</span>
        </div>
        <ul class="grid gap-2.5 sm:grid-cols-2">
          {service.bullets.map((b) => (
            <li class="flex items-center gap-2 text-xs text-foreground font-medium">
              <CheckCircle2 class="size-4 text-primary shrink-0" />
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-muted-foreground font-semibold">
          <Sparkles class="size-4 text-primary" />
          <span>Execution & Delivery Process</span>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          {MODAL_EXECUTION_PHASES.map((phase) => (
            <div class="rounded-lg border border-border/40 p-3 bg-background/50">
              <div class="text-[10px] font-mono text-primary uppercase font-bold">{phase.step}</div>
              <div class="text-xs font-semibold text-foreground mt-1">{phase.title}</div>
              <div class="text-[11px] text-muted-foreground mt-0.5">{phase.description}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="pt-4 border-t border-border/40 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-1 text-xs font-mono text-muted-foreground">
          <Cpu class="size-3.5 text-primary" />
          <span>Capability Slug: #{service.slug}</span>
        </div>
        <a href="/contact" class="inline-flex items-center rounded-full bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
          Engage {service.title}
          <ArrowRight class="ml-1.5 size-4" />
        </a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .capability-dialog {
    max-width: 42rem;
    width: calc(100% - 2rem);
    max-height: 85vh;
    overflow-y: auto;
    border: 1px solid color-mix(in oklch, var(--border) 100%, transparent);
    border-radius: var(--radius-2xl);
    padding: 0;
    color: var(--foreground);

    opacity: 0;
    transform: scale(0.95);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      overlay 0.2s allow-discrete,
      display 0.2s allow-discrete;
  }

  .capability-dialog[open] {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    .capability-dialog[open] {
      opacity: 0;
      transform: scale(0.95);
    }
  }

  .capability-dialog::backdrop {
    background: oklch(0.18 0.012 260 / 0.5);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .capability-dialog[open]::backdrop {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .capability-dialog {
      transition: none;
    }
  }
</style>

<script>
  function initCapabilityModal(dialog) {
    const closeBtn = dialog.querySelector('.capability-dialog-close');
    closeBtn?.addEventListener('click', () => dialog.close());

    // Click on the backdrop (the dialog element itself, outside its content box) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  document.querySelectorAll('[data-capability-modal]').forEach(initCapabilityModal);
</script>
