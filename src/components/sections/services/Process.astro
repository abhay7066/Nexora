---
import Section from "../../layout/Section.astro";
import SectionHeading from "../../common/SectionHeading.astro";
import Icon from "../../common/Icon.astro";
import { ArrowRight, CheckCircle2 } from "@lucide/astro";
import { SERVICE_PROCESS_STEPS } from "../../../data/site.js";
---

<Section class="relative overflow-hidden">
  <SectionHeading eyebrow="Operating Rhythm">
    A process built to <span class="text-gradient-primary">compound.</span>
    <Fragment slot="lead">
      From initial diagnostic audit to compounding revenue — one structured 4-phase operating rhythm.
    </Fragment>
  </SectionHeading>

  <div class="relative mt-16">
    <div aria-hidden="true" class="hidden lg:block absolute top-[48px] left-[10%] right-[10%] h-0.5 bg-gradient-to-r from-primary/10 via-primary/40 to-primary/10 z-0"></div>

    <div data-reveal-group class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 relative z-10">
      {SERVICE_PROCESS_STEPS.map((s, idx) => (
        <div class="hover-lift group surface-card flex flex-col justify-between p-7 border border-border/60 hover:border-primary/50 transition-all duration-300 rounded-2xl relative select-none">
          <div aria-hidden="true" class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-t-2xl"></div>

          <div>
            <div class="flex items-center justify-between gap-3 mb-6">
              <div class="flex items-center gap-3">
                <div class="grid size-11 place-items-center rounded-xl bg-primary/10 text-primary border border-primary/25 group-hover:scale-105 transition-transform shadow-sm">
                  <Icon name={s.icon} class="size-5" />
                </div>
                <span class="rounded-full bg-background border border-border/60 px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-primary font-semibold">
                  {s.timeframe}
                </span>
              </div>

              <div class="flex items-center gap-2">
                <span class="font-mono text-base font-bold text-foreground/80 group-hover:text-primary transition-colors">{s.step}</span>
                {idx < SERVICE_PROCESS_STEPS.length - 1 && (
                  <ArrowRight class="hidden lg:block size-4 text-muted-foreground/40 group-hover:text-primary group-hover:translate-x-1 transition-all" />
                )}
              </div>
            </div>

            <h3 class="font-display text-2xl font-bold text-foreground group-hover:text-primary transition-colors tracking-tight">{s.title}</h3>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-muted-foreground">{s.description}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-border/40 flex items-center gap-2 text-xs font-mono text-foreground font-medium">
            <CheckCircle2 class="size-4 text-primary shrink-0" />
            <span>{s.deliverable}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>
