---
import Section from "../../layout/Section.astro";
import SectionHeading from "../../common/SectionHeading.astro";
import { ArrowRight, Bot, Sparkles, Globe, Code2 } from "@lucide/astro";

const PILLARS = [
  {
    num: "01",
    title: "AI & Workflow Automation",
    icon: Bot,
    tagline: "Autonomous AI agents, Meta WhatsApp API bots, and custom LLM integrations that slash operating cost.",
    highlights: ["Autonomous AI Agents", "WhatsApp API Bots", "LLM Integrations"],
  },
  {
    num: "02",
    title: "Brand Strategy & Positioning",
    icon: Sparkles,
    tagline: "Category positioning, visual identity systems, and brand voice guidelines that earn trust instantly.",
    highlights: ["Category Positioning", "Visual Identity", "Messaging & Voice"],
  },
  {
    num: "03",
    title: "Software & Web Systems",
    icon: Globe,
    tagline: "SEO-optimized, ultra-fast marketing websites and headless storefronts engineered for conversion and speed.",
    highlights: ["Headless Storefronts", "Marketing Sites", "SEO Architecture"],
  },
  {
    num: "04",
    title: "SaaS & Internal Tools",
    icon: Code2,
    tagline: "Tailored SaaS web apps, customer portals, and internal telemetry tools built around your business operations.",
    highlights: ["SaaS Web Platforms", "Admin Portals", "Custom APIs"],
  },
];
---

<Section class="border-t border-border/40">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionHeading eyebrow="Core Capabilities">
      Four pillars. <span class="text-gradient-primary">One integrated engine.</span>
      <Fragment slot="lead">
        We combine AI automation, brand positioning, software systems, and custom SaaS into one growth engine.
      </Fragment>
    </SectionHeading>
    <a
      href="/services"
      class="hover-lift inline-flex items-center gap-1.5 rounded-full border border-border px-4 py-2 text-xs font-mono font-medium text-foreground transition-colors hover:border-primary/40"
    >
      <span>Explore All Services</span>
      <ArrowRight class="size-3.5" />
    </a>
  </div>

  <div data-reveal-group class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {PILLARS.map((pillar) => (
      <div class="surface-card group flex flex-col justify-between p-7 border border-border/60 hover:border-primary/40 transition-all duration-300 rounded-2xl">
        <div>
          <div class="flex items-center justify-between">
            <div class="grid size-11 place-items-center rounded-xl bg-primary/10 text-primary border border-primary/20">
              <pillar.icon class="size-5" />
            </div>
            <span class="font-mono text-xs font-semibold text-muted-foreground/70">{pillar.num}</span>
          </div>

          <h3 class="mt-6 font-display text-xl font-semibold text-foreground tracking-tight group-hover:text-primary transition-colors">
            {pillar.title}
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-muted-foreground leading-relaxed">{pillar.tagline}</p>
        </div>

        <div class="mt-6 pt-4 border-t border-border/40 flex flex-wrap gap-1.5">
          {pillar.highlights.map((h) => (
            <span class="rounded-md bg-surface border border-border/60 px-2 py-0.5 text-[11px] font-mono text-muted-foreground">
              {h}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>
