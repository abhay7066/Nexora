---
interface Props {
  class?: string;
  imgClassName?: string;
}
const { class: className, imgClassName = "size-9" } = Astro.props;
---

<a href="/" aria-label="Nexora Technologies — home" class={`group inline-flex items-center gap-2.5 ${className ?? ""}`}>
  <img src="/logo.png" alt="" class={`object-contain shrink-0 ${imgClassName}`} />
  <div class="flex flex-col items-end leading-none pr-1.5">
    <span class="font-display text-lg font-semibold tracking-tight text-foreground">Nexora</span>
    <span class="relative font-display text-[9.5px] font-medium tracking-tight text-muted-foreground -mt-1">
      Technologies
      <sup class="absolute left-[calc(100%+1px)] top-0 text-[6.5px] font-normal leading-none select-none">™</sup>
    </span>
  </div>
</a>
