---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
---

<Layout title="Not found — Nexora" description="The page you're looking for doesn't exist." robots="noindex">
  <section class="relative min-h-[70vh] pt-32 pb-24">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10" style="background: var(--gradient-hero)"></div>
    <div aria-hidden="true" class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <Container>
      <div class="max-w-2xl animate-fade-up">
        <div class="eyebrow text-primary">404</div>
        <h1 class="text-gradient mt-6 text-5xl leading-[1.05] tracking-tight sm:text-6xl">
          This page took a <span class="text-gradient-primary italic">wrong turn.</span>
        </h1>
        <p class="mt-6 text-lg text-muted-foreground">
          The URL doesn't match anything we've shipped. Head back home, or jump straight into what we do.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/" class="hover-lift inline-flex items-center rounded-full bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition hover:opacity-90">
            Back to home
          </a>
          <a href="/services" class="hover-lift inline-flex items-center rounded-full border border-border px-6 py-3 text-sm font-medium text-foreground transition hover:border-primary/40">
            Explore services
          </a>
        </div>
      </div>
    </Container>
  </section>
</Layout>
